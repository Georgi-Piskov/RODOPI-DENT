      ],
      "alwaysOutputData": true,
      "credentials": {
        "googleApi": {
          "id": "CNqF1lQxBCTbo24q",
          "name": "RODOPI_DENT_SERVICE_ACCOUNT"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst requestedName = $('Validate Input').first().json.name || '';\nconst normalized = (requestedName || '').toLowerCase().trim();\n\n// Exact name match (case-insensitive). A patient may have several phones\n// (one row each); the newest one is returned as `phone`, all of them in `phones`.\nconst found = [];\nfor (const item of items) {\n  const row = item.json || {};\n  if (!row.name || !row.phone) continue;\n  if (String(row.name).toLowerCase().trim() === normalized) {\n    found.push({ phone: String(row.phone).trim(), createdAt: String(row.createdAt || ''),\n                 row: Number(row.row_number) || 0, name: row.name });\n  }\n}\nfound.sort((a, b) => (b.createdAt.localeCompare(a.createdAt)) || (b.row - a.row));\n\nreturn [{\n  json: {\n    success: true,\n    name: requestedName,\n    matchedName: found.length ? found[0].name : '',\n    phone: found.length ? found[0].phone : '',\n    phones: found.map(f => ({ phone: f.phone, createdAt: f.createdAt })),\n    found: found.length > 0\n  }\n}];"
      },
      "id": "ad323cd6-d43e-4250-83cb-f7753bf30c5d",
      "name": "Extract Phone",
