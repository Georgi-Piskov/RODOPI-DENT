        "jsCode": "const query = $input.first().json.query || {};\nconst name = (query.name || '').trim();\n\nif (!name) {\n  return [{ json: { success: false, error: 'Missing name parameter', phone: '' } }];\n}\n\nreturn [{ json: { name: name, normalizedName: name.toLowerCase().trim() } }];"
      },
