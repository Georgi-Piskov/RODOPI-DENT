    {
      "parameters": {
        "jsCode": "\n// --- Patient matching helpers (same logic in upsert + recovery) ---\n// Strip leading status icons (⏳ ✅ 🔔 ...) and stray punctuation from a name\nfunction cleanName(n) {\n  return String(n || '')\n    .replace(/^[^\\p{L}\\p{N}]+/u, '')\n    .replace(/\\s+/g, ' ')\n    .replace(/[\\s.,;:\\-]+$/, '')\n    .trim();\n}\nfunction nameKey(n) {\n  return cleanName(n).toLowerCase();\n}\n// Normalize to +359 international format (text-safe for Google Sheets)\nfunction toInternational(p) {\n  let phone = String(p || '').replace(/[\\s()\\-.\\/]/g, '');\n  if (!phone) return '';\n  if (phone.startsWith('00359')) phone = '+359' + phone.slice(5);\n  else if (phone.startsWith('359')) phone = '+' + phone;\n  else if (phone.startsWith('0') && phone.length >= 10) phone = '+359' + phone.slice(1);\n  else if (/^[89]\\d{8}$/.test(phone)) phone = '+359' + phone;\n  else if (!phone.startsWith('+') && phone.length >= 9) phone = '+359' + phone;\n  return phone;\n}\n// Core digits for comparison: +359887493315 / 0887493315 / 887493315 -> 887493315\nfunction phoneKey(p) {\n  return String(p || '').replace(/\\D/g, '').replace(/^00/, '').replace(/^359/, '').replace(/^0/, '');\n}\nfunction isBlockName(n) {\n  return /блокиран|почивка|отпуск|blocked/i.test(String(n || ''));\n}\n\n// Find the target row. The client sends the row number it saw plus the\n// original name/phone; rows can shift (other deletes), so the row number is\n// only trusted when that row still holds the same patient.\nfunction locate(rows, body) {\n  const wantName = nameKey(body.originalName);\n  const wantPhone = phoneKey(body.originalPhone);\n  const same = r => nameKey(r.name) === wantName && phoneKey(r.phone) === wantPhone;\n  const byNumber = rows.find(r => Number(r.row_number) === Number(body.rowNumber));\n  if (byNumber && same(byNumber)) return byNumber;\n  return rows.find(same) || null;\n}\nconst rows = $('Read Patients').all().map(i => i.json).filter(r => r && r.row_number);\nconst body = $('Webhook').first().json.body || {};\nconst target = locate(rows, body);\n\nif (!target) {\n  return [{ json: { ok: false, error: 'Пациентът не е намерен (може би вече е изтрит или променен). Обновете списъка.' } }];\n}\nconst name = cleanName(body.name);\nif (!name) return [{ json: { ok: false, error: 'Името не може да е празно' } }];\nconst phone = toInternational(body.phone);\nif (phone && !/^\\+\\d{9,15}$/.test(phone)) {\n  return [{ json: { ok: false, error: 'Невалиден телефон' } }];\n}\nreturn [{ json: { ok: true, rowNumber: target.row_number, name, phone } }];\n"
      },
